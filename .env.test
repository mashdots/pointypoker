# E2E test environment (safe to commit — no secrets).
# Loaded by Vite when running in `--mode test`.
#
# Selects the v3 (legacy) experience and points Firebase at the local
# emulators via VITE_USE_EMULATORS. The project id uses the `demo-` prefix so
# the Firebase emulator runs fully offline with no real credentials.

VITE_VERSION=v3.0.1
VITE_USE_EMULATORS=true

VITE_FB_API_KEY=demo-api-key
VITE_FB_AUTH_DOMAIN=demo-yappy.firebaseapp.com
VITE_FB_PROJECT_ID=demo-yappy
VITE_FB_STORAGE_BUCKET=demo-yappy.appspot.com
VITE_FB_MESSAGING_SENDER_ID=000000000000
VITE_FB_APP_ID=1:000000000000:web:0000000000000000000000
